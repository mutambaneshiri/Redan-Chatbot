# TEMPLATE ONLY — this file is committed to git.
# NEVER put a real key in this file. Copy it first:
#   cp .env.example .env.local
# and put real keys in .env.local, which is gitignored.

# ─── Which LLM backend to use ────────────────────────────────────────────────
# Options: mistral | google | groq | openrouter | ollama | openai | anthropic
# Default is mistral: the largest free allowance with reliable function calling.
LLM_PROVIDER=mistral

# Override the model. Each provider has a default in
# src/lib/providers/registry.ts. Model names change often; a 404 means the name
# has been retired, and `npm run models` lists what is served now.
# Free tiers do not include every model: on Mistral the ministral family is
# available while mistral-small, mistral-medium and mistral-large are not.
# LLM_MODEL=ministral-14b-latest

# Point the chosen provider at a different endpoint (remote Ollama, a proxy, or
# any other OpenAI-compatible server).
# LLM_BASE_URL=http://192.168.1.50:11434/v1


# How fully the bot answers in Shona and isiNdebele.
#   greeting (default) — greets in the customer's language, answers in English.
#   full — answers entirely in Shona / isiNdebele. Only use with a model that
#          writes them well (e.g. Claude); small free models write them badly.
# REPLY_LANGUAGE_MODE=greeting

# ─── API keys — you only need the one for your chosen provider ───────────────

# FREE, no card required. https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# FREE, roughly 20 requests/day/model. https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# FREE. https://console.groq.com/keys
# GROQ_API_KEY=

# FREE models available (those with a ":free" suffix). https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Ollama needs NO key. Install from https://ollama.com/download, then:
#   ollama pull llama3.1 && ollama serve
# Then set LLM_PROVIDER=ollama

# PAID. https://platform.openai.com/api-keys
# (The ChatGPT app has a free tier; the API does not.)
# OPENAI_API_KEY=

# PAID. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# REDAN_EFFORT=medium   # Claude only: low | medium | high


# ─── Evals ───────────────────────────────────────────────────────────────────
# The grader. Defaults to the same provider as the bot. A grader should be at
# least as capable as the model it grades.
# JUDGE_PROVIDER=mistral
# JUDGE_MODEL=
# EVAL_CONCURRENCY=4    # lower this if a free tier rate-limits you


# ─── WhatsApp Business Cloud API (optional) ──────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
